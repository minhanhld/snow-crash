#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <arpa/inet.h>
#include <sys/socket.h>

int main(int argc, char **argv)
{
    char *filename;
    char *host;
    int sockfd;
    int filefd;
    ssize_t bytes_read;
    char buffer[4096];
    struct sockaddr_in sin;
    if (argc < 3) {
        printf("%s file host\n\tsends file to host if you have access to it\n", argv[0]);
        exit(1);
    }

    filename = argv[1];
    host     = argv[2];

    if (access(filename, R_OK) != 0) {
        printf("You don't have access to %s\n", filename);
        return 1;
    }
    printf("Connecting to %s:6969 .. ", host);
    fflush(stdout);

    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    memset(&sin, 0, sizeof(sin));
    sin.sin_family      = AF_INET;
    sin.sin_port        = htons(6969);       // 0x1b39 == 6969
    sin.sin_addr.s_addr = inet_addr(host);

    if (connect(sockfd, (struct sockaddr *)&sin, sizeof(sin)) == -1) {
        printf("Unable to connect to host %s\n", host);
        exit(1);
    }

    // Send a banner/handshake string
    if (write(sockfd, ".*( )*.\n", 8) == -1) {
        printf("Unable to write banner to host %s\n", host);
        exit(1);
    }

    printf("Connected!\nSending file .. ");
    fflush(stdout);

    // Open and read the file
    filefd = open(filename, O_RDONLY);
    if (filefd == -1) {
        puts("Damn. Unable to open file");
        exit(1);
    }

    bytes_read = read(filefd, buffer, sizeof(buffer));
    if (bytes_read == -1) {
        printf("Unable to read from file: %s\n", strerror(errno));
        exit(1);
    }

    // Send file contents over the socket
    write(sockfd, buffer, bytes_read);
    puts("wrote file!");

    return 0;
}